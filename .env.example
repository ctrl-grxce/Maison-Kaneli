# ── Supabase (réservations) ────────────────────────────────────────────────
# URL du projet Supabase et clé « publishable ». Fournies par le dashboard.
# ⚠️ SANS préfixe NEXT_PUBLIC_ : ces valeurs restent côté serveur et ne sont
# jamais visibles dans le navigateur.
SUPABASE_URL=
SUPABASE_KEY=

# ── Emails transactionnels ─────────────────────────────────────────────────
# Adresse qui reçoit les notifications de rendez-vous (email de Maison Kanali)
BOOKING_EMAIL_TO=maisonkanali@gmail.com

# Transport n° 1 (recommandé) : Gmail. GMAIL_APP_PASSWORD est un « mot de
# passe d'application » créé sur le compte Google (Sécurité → Validation en
# deux étapes → Mots de passe d'application). Sans transport configuré, les
# réservations sont bien enregistrées mais aucun email n'est envoyé.
GMAIL_USER=maisonkanali@gmail.com
GMAIL_APP_PASSWORD=

# Transport n° 2 : Resend (https://resend.com), pour un futur domaine vérifié.
RESEND_API_KEY=

# Expéditeur des emails Resend. Doit appartenir à un domaine vérifié.
# En attendant la vérification du domaine : onboarding@resend.dev
BOOKING_EMAIL_FROM="Maison Kanali <onboarding@resend.dev>"

# ── Sécurité ───────────────────────────────────────────────────────────────
# Cadenas d'urgence à 3 étages (voir docs/SECURITE.md) :
#   0 = normal · 1 = vigilance · 2 = verrou écritures · 3 = cadenas total
SECURITY_LOCKDOWN=0
# Secret partagé middleware ↔ route de report. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SECURITY_REPORT_SECRET=
# Adresse qui reçoit les alertes d'intrusion (sinon BOOKING_EMAIL_TO).
SECURITY_ALERT_TO=

# ── Paiement des acomptes (docs/PAIEMENT.md) ───────────────────────────────
# Interrupteur général : 0 (ou vide) = site identique à avant, aucun paiement.
# Ne passer à 1 qu'avec les clés Stripe en place.
PAYMENTS_ENABLED=0
# Clé secrète Stripe (sk_test_… en mode test, sk_live_… en production).
# ⚠️ À coller soi-même (éditeur de texte ou dashboard Vercel — jamais de
# pipe PowerShell, piège BOM). Ne jamais la partager ni la committer.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), fourni par Stripe au moment de
# créer l'endpoint /api/stripe/webhook (dashboard → Développeurs → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ── Site & domaine ─────────────────────────────────────────────────────────
# URL publique du site (sans slash final). Sert au sitemap, robots.txt, JSON-LD,
# balises Open Graph… À passer sur le vrai domaine dès qu'il est branché
# (voir docs/DOMAINE.md). Par défaut : https://maison-kanali.vercel.app
NEXT_PUBLIC_SITE_URL=
# Code de vérification Google Search Console (méthode « balise HTML »).
# Inutile si la propriété est vérifiée par enregistrement DNS TXT.
GOOGLE_SITE_VERIFICATION=
